# Aliyun Function Compute deployment configuration.
# Copy to deploy/aliyun/.env and fill in the secrets, then run:
#   npm run provision:aliyun   # one-time: VPC/NAS discovery + creation
#   npm run deploy:aliyun      # build + create/update the FC function + HTTP trigger
#
# deploy/aliyun/.env is git-ignored.

REGION=cn-hangzhou
FUNCTION_NAME=koreader-sync

# Required secrets (generate strong random values, e.g. `openssl rand -hex 32`).
PASSWORD_PEPPER=change_me
ADMIN_TOKEN=change_me

# Persistent SQLite database path inside the FC instance. The NAS mount point
# directory is /mnt/data, so keep this under it.
SQLITE_PATH=/mnt/data/koreader-sync.db

SESSION_TTL_HOURS=168

# Filled in automatically by scripts/provision-aliyun.sh.
VPC_ID=
VSWITCH_ID=
SECURITY_GROUP_ID=
NAS_FILE_SYSTEM_ID=
NAS_MOUNT_TARGET_DOMAIN=
NAS_MOUNT_DIR=/mnt/data
